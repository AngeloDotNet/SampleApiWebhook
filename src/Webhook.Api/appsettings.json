{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=webhooks;Username=postgres;Password=postgres"
    },
    "Webhook": {
        "Secret": "REPLACE_WITH_WEBHOOK_SECRET_PLACEHOLDER",
        "AllowSkewSeconds": 300
    },
    "Outbox": {
        "DataKeyB64": "REPLACE_WITH_BASE64_32_BYTE_KEY_PLACEHOLDER",
        "BatchSize": 20,
        "MaxAttempts": 10
    },
    "RabbitMq": {
        "Host": "localhost",
        "Username": "guest",
        "Password": "guest",
        "Queue": "webhooks",
        "ConfirmTimeoutSeconds": 10
    },
    "AllowedHosts": "*"
}
